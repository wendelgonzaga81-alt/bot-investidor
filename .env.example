# Configure estas variáveis no painel da Vercel (Settings > Environment Variables).
# Nunca coloque os valores reais no código nem no chat.
GEMINI_API_KEY=
BRAPI_TOKEN=
FIRECRAWL_API_KEY=
# Opcionais:
# GEMINI_MODEL=gemini-3.8-flash
# ANTHROPIC_API_KEY=   (alternativa paga; usada só se não houver GEMINI_API_KEY ou se AI_PROVIDER=anthropic)
# AI_PROVIDER=gemini

# Segurança (ver SEGURANCA.md):
# SITE_LOCKDOWN=1          desliga todas as APIs (chat, radar) na hora
# AI_DISABLED=1            desliga só o chat com IA
# RATE_LIMIT_CHAT_PER_MIN=8
# RATE_LIMIT_API_PER_MIN=30
# RATE_LIMIT_CHAT_PER_DAY=150
# GLOBAL_CHAT_PER_MIN=60

# Painel administrativo (/admin):
# ADMIN_PASSWORD=          senha do painel, 12+ caracteres (sem ela o painel fica desligado)
# ADMIN_SECRET=            texto aleatório longo para assinar a sessão do painel
# Métricas e cadastros (Vercel > Storage > Upstash Redis, grátis; a Vercel preenche sozinha):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# CONTACT_EMAIL=           e-mail de contato exibido na Política de Privacidade
